PORT=3000
NODE_ENV=development
DB_HOST=localhost
DB_PORT=3306
DB_USER=eliabetech
DB_PASSWORD=change-me
DB_NAME=eliabetech_login
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Email de saída: use credenciais SMTP/de aplicativo, nunca a senha pessoal da caixa postal.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-app-password
MAIL_FROM=EliabeTech <no-reply@example.com>
APP_BASE_URL=http://localhost:3000

# Chave aleatória de 32 bytes codificada em 64 caracteres hexadecimais para criptografar segredos TOTP.
MFA_ENCRYPTION_KEY=replace-with-64-hexadecimal-characters-generated-securely

# Defina somente ao executar npm run seed; não faça commit de senhas.
SEED_USER_1_PASSWORD=
SEED_USER_2_PASSWORD=
SEED_USER_3_PASSWORD=
SEED_USER_4_PASSWORD=
